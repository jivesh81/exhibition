# SafeSight AI - Environment Configuration
# Copy this file to .env and fill in your values

# Optional: Custom model paths
# SAFE_SIGHT_PPE_MODEL=backend/models/ppe_yolo.pt
# SAFE_SIGHT_POSE_MODEL=backend/models/yolov8n-pose.pt

# Optional: Voice TTS configuration
# TTS_ENGINE=pyttsx3  # or piper, edge-tts
# PIPER_MODEL_PATH=/path/to/piper/model.onnx

# Optional: Database
# DATABASE_URL=sqlite:///backend/safesight.db

# Optional: Server
# HOST=127.0.0.1
# PORT=8000

# Optional: Alert thresholds
# ALERT_COOLDOWN=8.0
# CRITICAL_COOLDOWN=3.0
# WARNING_THRESHOLD=25
# HIGH_THRESHOLD=50
# CRITICAL_THRESHOLD=75